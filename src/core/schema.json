            "widgetOptions": "{\"choices\":[\"Renuncia\",\"Falta de pago\",\"Fallecimiento\",\"CambioEscuela\",\"Otro\"]}"
          }
        },
        {
          "id": "activo",
          "fields": {
            "label": "Activo",
            "type": "Bool",
            "isFormula": true,
            "formula": "$fecha_baja is None"
          }
        },
        {
          "id": "habilitado_electoral",
          "fields": {
            "label": "Habilitado electoral",
            "type": "Bool",
            "isFormula": true,
            "formula": "$tipo_socio == 'Activo' and $fecha_baja is None and (datetime.date.today() - $fecha_alta).days >= 30"
          }
        }
      ]
