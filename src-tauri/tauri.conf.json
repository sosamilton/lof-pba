{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LOF",
  "version": "2.0.1",
  "identifier": "com.lof.pba",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LOF — Lazos que Organizan el Futuro",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Gestión de cooperadoras escolares de PBA",
    "longDescription": "LOF es una aplicación para gestionar cooperadoras escolares de la Provincia de Buenos Aires: tesorería, comunidad, gobierno institucional y cierre de ciclo.",
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/sosamilton/lof-pba/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}
