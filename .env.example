# .env.example — copiar a .env y ajustar valores.
# docker-compose.yml y docker-compose.grist.yml leen estas variables.

# # --- Grist ---
# GRIST_PORT=8489
# GRIST_PERSIST_DIR=./data/grist-dev/persist
# GRIST_DOCS_DIR=./data/grist-dev/docs

# # --- MinIO (S3 para Grist attachments) ---
# MINIO_PORT=9100
# MINIO_CONSOLE_PORT=9101
# MINIO_DATA_DIR=./data/minio-dev

# --- Vite dev server ---
DEV_PORT=5173

# --- CouchDB (sync target para PouchDB) ---
# Puerto expuesto en el host
COUCHDB_PORT=5984
# Directorio de persistencia (dev)
COUCHDB_DATA_DIR=./data/couchdb-dev
# Credenciales admin (cambiar en prod!)
COUCHDB_USER=admin
COUCHDB_PASSWORD=admin

# --- App: valores horneados en el bundle via Vite ---
# Por defecto el guardado remoto está DESACTIVADO (solo local/PouchDB).
# Las vars VITE_COUCHDB_* solo pre-configuran URL/credenciales en la UI
# de Configuración → Sincronización. El usuario debe activar sync manualmente.
#
# Para que sync arranque activado por defecto (sin intervención del usuario),
# descomentar VITE_SYNC_ENABLED=true. Igualmente el usuario puede desactivarlo
# desde Configuración.
#
# VITE_SYNC_ENABLED=true

# URL que el browser usa para sync PouchDB↔CouchDB.
# En dev local, el host accede via localhost:COUCHDB_PORT.
# En prod, sería https://couchdb.midominio.com/lof
# VITE_COUCHDB_URL=http://localhost:5984/lof
# VITE_COUCHDB_USER=admin
# VITE_COUCHDB_PASSWORD=admin
