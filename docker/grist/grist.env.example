# =============================================================================
# Grist Configuration
# =============================================================================
# Copy this file to .env (project root) and customize.
# Docker Compose reads .env automatically for ${VAR} interpolation.
#
# All values have sensible defaults for local/offline use.
# =============================================================================

# --- Admin & Auth -----------------------------------------------------------
# Email of the admin account (created on first run)
GRIST_ADMIN_EMAIL=admin@localhost

# Require login (no anonymous access)
GRIST_FORCE_LOGIN=true

# Session secret — SET TO A RANDOM STRING IN PRODUCTION!
# Example: openssl rand -hex 32
GRIST_SESSION_SECRET=change-me-please

# Single team name (simplifies URLs — no /o/team-name prefix)
GRIST_SINGLE_ORG=cooperadora

# --- OIDC (optional SSO) ----------------------------------------------------
# To enable OIDC, create docker/grist/oidc.env with:
#
#   GRIST_OIDC_IDP_ISSUER=https://your-idp/.well-known/openid-configuration
#   GRIST_OIDC_IDP_CLIENT_ID=grist
#   GRIST_OIDC_IDP_CLIENT_SECRET=your-secret
#   GRIST_OIDC_SP_HOST=https://grist.example.com
#   GRIST_OIDC_IDP_SCOPES=openid email profile
#   GRIST_OIDC_IDP_SKIP_END_SESSION_ENDPOINT=true
#   GRIST_OIDC_SP_IGNORE_EMAIL_VERIFIED=true
#
# Redirect URI: https://<grist-domain>/oauth2/callback
# The oidc.env file is loaded via env_file (optional, no error if absent).

# --- MinIO (S3-compatible snapshots) ----------------------------------------
# Credentials for the internal MinIO instance
# CHANGE THESE IN PRODUCTION!
MINIO_ROOT_USER=grist
MINIO_ROOT_PASSWORD=grist-secret

# --- Ports ------------------------------------------------------------------
GRIST_PORT=8089
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Data directories (bind mounts) -----------------------------------------
# Paths are relative to docker/grist/docker-compose.grist.yml (the included file).
# When set in .env at project root, use paths relative to project root instead.
GRIST_PERSIST_DIR=../../data/grist/persist
GRIST_DOCS_DIR=../../data/grist/docs
MINIO_DATA_DIR=../../data/minio

# --- Grist image ------------------------------------------------------------
GRIST_TAG=latest

# --- Sandbox ----------------------------------------------------------------
# gvisor isolates Python formulas from the host (recommended for production)
# Set to 'none' if gvisor is not available (e.g., pre-Sandy Bridge CPU, some VMs)
GRIST_SANDBOX_FLAVOR=gvisor

# --- Public URL (optional) --------------------------------------------------
# Set if behind a reverse proxy / different host
# APP_HOME_URL=https://grist.example.com
